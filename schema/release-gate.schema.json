{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReleaseGateConfig",
  "description": "App-independent remote gate and kill-switch configuration schema for mobile applications",
  "type": "object",
  "required": ["appId", "environment", "updatedAt", "killSwitch", "minBuild"],
  "properties": {
    "appId": {
      "type": "string",
      "description": "Unique slug identifying the application (e.g. geocam)"
    },
    "environment": {
      "type": "string",
      "enum": ["preview", "production", "staging"],
      "description": "Deployment environment targeted by this gate file"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when this configuration was last modified"
    },
    "killSwitch": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "When true, blocks application launch completely"
        },
        "badge": {
          "type": "string",
          "description": "Short diagnostic pill displayed on the lockout screen"
        },
        "title": {
          "type": "string",
          "description": "Lockout header title"
        },
        "message": {
          "type": "string",
          "description": "Detailed explanation shown to users/testers"
        },
        "contactUrl": {
          "type": "string",
          "description": "Optional support or download URL"
        }
      }
    },
    "minBuild": {
      "type": "object",
      "required": ["enforced", "minAllowedBuildNumber"],
      "properties": {
        "enforced": {
          "type": "boolean",
          "description": "Whether minimum build requirement is strictly enforced"
        },
        "minAllowedBuildNumber": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum acceptable build/iteration number (e.g. 5)"
        },
        "minAllowedVersion": {
          "type": "string",
          "description": "Optional minimum semantic version string (e.g. 1.0.0)"
        },
        "message": {
          "type": "string",
          "description": "Message displayed when build number is below threshold"
        }
      }
    },
    "revokedBuilds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of specific build IDs or iteration strings to block immediately (e.g. ['1.0.0_b2', '1.0.0_b4'])"
    },
    "notice": {
      "type": "object",
      "properties": {
        "active": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "title": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
